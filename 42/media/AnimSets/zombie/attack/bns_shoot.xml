<?xml version="1.0" encoding="utf-8"?>
<!-- BNS: one-shot pistol fire using the player's shoot animation
     (BNSAnim=shoot, pulsed by BNS_Anim.lua then reset). -->
<animNode>
	<m_Name>bns_shoot</m_Name>
	<m_AnimName>Bob_ShootPistol</m_AnimName>
	<m_Looped>False</m_Looped>
	<m_Priority>12</m_Priority>
	<m_Conditions>
		<m_Name>BNSNPC</m_Name>
		<m_Type>STRING</m_Type>
		<m_StringValue>true</m_StringValue>
	</m_Conditions>
	<m_Conditions>
		<m_Name>BNSAnim</m_Name>
		<m_Type>STRING</m_Type>
		<m_StringValue>shoot</m_StringValue>
	</m_Conditions>
</animNode>
